{
  "name": "heroquill",
  "version": "1.32.0",
  "private": true,
  "description": "Offline-first D&D 5e character sheet maker (print and play).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/build-site.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:corpus": "vitest run src/import/aurora/corpus",
    "test:print": "tsx scripts/print-check/pages.ts",
    "site:sheets": "tsx scripts/print-check/blankSheets.ts",
    "export:print-characters": "tsx scripts/print-check/export.ts",
    "icons": "node scripts/make-icons.mjs",
    "data:srd51": "tsx scripts/srd51/build.ts",
    "data:srd52": "tsx scripts/srd52/build.ts",
    "docs:pack": "tsx scripts/pack-docs.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@preact/signals": "^1.3.0",
    "pdf-lib": "^1.17.1",
    "preact": "^10.24.0",
    "qrcode-generator": "^2.0.4",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@preact/preset-vite": "^2.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  }
}
